{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic gesture recipe v1",
  "type": "object",
  "required": ["schema_version", "id", "scenario_id", "coordinate_space", "preconditions", "steps", "expected_observations"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string"}, "scenario_id": {"type": "string"},
    "coordinate_space": {"const": "screen_logical_points"},
    "preconditions": {"type": "object"}, "role": {"enum": ["training", "holdout"]},
    "steps": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["at_ms", "action"],
      "properties": {"at_ms": {"type": "number", "minimum": 0}, "action": {"enum": ["down", "move", "up", "cancel", "tap", "command", "checkpoint"]}, "x": {"type": "number"}, "y": {"type": "number"}, "command": {"type": "string"}, "marker": {"type": "string"}, "pointer_id": {"type": "integer", "minimum": 0}}
    }},
    "expected_observations": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "string"}
  }
}
