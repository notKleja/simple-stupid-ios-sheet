{
  "schema_version": 1,
  "policy": "Each case crossed with OS/device geometry/orientation; unavailable cells remain unresolved",
  "environment_axes": {"ios_major": [26, 27], "device_geometry": ["iphone_a", "iphone_b"], "orientation": ["portrait", "landscape"]},
  "minimum_trials": 10,
  "geometry_requirement": "Bind iphone_a and iphone_b to two observed distinct logical display sizes; inventory is not a measurement",
  "required_dimensions": {
    "detents": ["small_custom", "medium", "large", "medium_large", "custom_large", "three_custom"],
    "interaction": ["present", "dismiss", "slow_drag", "fast_drag", "overdrag", "cancel", "scroll_handoff", "background_touch"],
    "modal": ["modal", "nonmodal", "interactive_dismiss_disabled"],
    "content": ["fixed", "short_scroll", "long_scroll", "horizontal_pager", "text_field", "dynamic_height"]
  },
  "cases": [
    {"id": "programmatic", "scenario_id": "native.medium_large.programmatic", "role": "training", "detents": "medium_large", "interaction": "present", "modal": "modal", "content": "fixed", "checks": ["present", "large_to_medium", "medium_to_large", "dismiss", "side_spacing", "presenter"]},
    {"id": "small", "scenario_id": "custom.small", "role": "training", "detents": "small_custom", "interaction": "present", "modal": "modal", "content": "fixed"},
    {"id": "medium", "scenario_id": "medium.basic", "role": "training", "detents": "medium", "interaction": "present", "modal": "modal", "content": "fixed"},
    {"id": "large", "scenario_id": "large.basic", "role": "training", "detents": "large", "interaction": "dismiss", "modal": "modal", "content": "fixed"},
    {"id": "custom_large", "scenario_id": "custom_large.programmatic", "role": "training", "detents": "custom_large", "interaction": "present", "modal": "modal", "content": "fixed"},
    {"id": "three_custom", "scenario_id": "custom.three", "role": "training", "detents": "three_custom", "interaction": "slow_drag", "modal": "modal", "content": "fixed"},
    {"id": "slow_drag", "scenario_id": "medium_large.drag.slow", "role": "training", "detents": "medium_large", "interaction": "slow_drag", "modal": "modal", "content": "fixed"},
    {"id": "fast_drag", "scenario_id": "medium_large.drag.fast", "role": "training", "detents": "medium_large", "interaction": "fast_drag", "modal": "modal", "content": "fixed"},
    {"id": "overdrag", "scenario_id": "medium_large.overdrag", "role": "training", "detents": "medium_large", "interaction": "overdrag", "modal": "modal", "content": "fixed", "distances_pt": [10,20,40,80,120,180], "directions": ["above_max", "below_min"]},
    {"id": "cancel", "scenario_id": "dismiss.cancel", "role": "training", "detents": "medium_large", "interaction": "cancel", "modal": "modal", "content": "fixed"},
    {"id": "disabled", "scenario_id": "dismiss.disabled", "role": "training", "detents": "medium_large", "interaction": "overdrag", "modal": "interactive_dismiss_disabled", "content": "fixed"},
    {"id": "nonmodal", "scenario_id": "nonmodal.medium", "role": "training", "detents": "medium_large", "interaction": "background_touch", "modal": "nonmodal", "content": "fixed", "checks": ["tap", "scroll", "control_activation", "focus", "threshold_crossing"]},
    {"id": "modal", "scenario_id": "modal.background", "role": "training", "detents": "medium_large", "interaction": "background_touch", "modal": "modal", "content": "fixed"},
    {"id": "short_scroll", "scenario_id": "scroll.short", "role": "training", "detents": "medium_large", "interaction": "scroll_handoff", "modal": "modal", "content": "short_scroll"},
    {"id": "long_scroll", "scenario_id": "scroll.long", "role": "training", "detents": "medium_large", "interaction": "scroll_handoff", "modal": "modal", "content": "long_scroll", "offsets_pt": [0,1,400], "origins": ["grabber", "content", "interactive_child"]},
    {"id": "content_first", "scenario_id": "scroll.content_first", "role": "training", "detents": "medium_large", "interaction": "scroll_handoff", "modal": "modal", "content": "long_scroll"},
    {"id": "pager", "scenario_id": "pager.diagonal", "role": "training", "detents": "medium_large", "interaction": "slow_drag", "modal": "modal", "content": "horizontal_pager"},
    {"id": "keyboard", "scenario_id": "keyboard.medium", "role": "training", "detents": "medium_large", "interaction": "slow_drag", "modal": "modal", "content": "text_field", "checks": ["focus_before", "focus_after", "interactive_close", "drag_open", "change_detent"]},
    {"id": "dynamic", "scenario_id": "content.dynamic", "role": "training", "detents": "custom_large", "interaction": "present", "modal": "modal", "content": "dynamic_height", "phases": ["idle", "drag", "animation", "keyboard"]},
    {"id": "stack", "scenario_id": "stack.two", "role": "training", "detents": "medium_large", "interaction": "cancel", "modal": "modal", "content": "fixed", "configurations": ["full_full", "medium_full", "custom_medium", "three"]},
    {"id": "form", "scenario_id": "form.sizing", "role": "training", "detents": "custom_large", "interaction": "present", "modal": "modal", "content": "fixed", "checks": ["page", "form", "preferred_width", "edge_attached", "content_sized", "placement"]},
    {"id": "interrupt", "scenario_id": "motion.interrupt", "role": "training", "detents": "medium_large", "interaction": "fast_drag", "modal": "modal", "content": "fixed", "checks": ["grab_open", "reverse", "grab_settle", "retarget", "cancel_dismiss"]},
    {"id": "accessibility", "scenario_id": "accessibility.settings", "role": "training", "detents": "medium_large", "interaction": "dismiss", "modal": "modal", "content": "fixed", "checks": ["reduce_motion", "larger_text", "voiceover_dismiss"]},
    {"id": "holdout_reverse", "scenario_id": "holdout.reverse_settle", "role": "holdout", "detents": "medium_large", "interaction": "fast_drag", "modal": "modal", "content": "fixed"},
    {"id": "holdout_near_detents", "scenario_id": "holdout.close_detents", "role": "holdout", "detents": "three_custom", "interaction": "slow_drag", "modal": "modal", "content": "fixed"},
    {"id": "holdout_scroll_one", "scenario_id": "holdout.scroll_one_point", "role": "holdout", "detents": "medium_large", "interaction": "scroll_handoff", "modal": "modal", "content": "long_scroll"},
    {"id": "holdout_keyboard", "scenario_id": "holdout.keyboard_retarget", "role": "holdout", "detents": "medium_large", "interaction": "fast_drag", "modal": "modal", "content": "text_field"},
    {"id": "holdout_nonmodal", "scenario_id": "holdout.nonmodal_threshold", "role": "holdout", "detents": "medium_large", "interaction": "background_touch", "modal": "nonmodal", "content": "fixed"},
    {"id": "holdout_stack", "scenario_id": "holdout.stack_cancel", "role": "holdout", "detents": "custom_large", "interaction": "cancel", "modal": "modal", "content": "fixed"},
    {"id": "holdout_diagonal", "scenario_id": "holdout.pager_diagonal", "role": "holdout", "detents": "medium_large", "interaction": "fast_drag", "modal": "modal", "content": "horizontal_pager"},
    {"id": "holdout_disabled", "scenario_id": "holdout.disabled_high_velocity", "role": "holdout", "detents": "medium_large", "interaction": "overdrag", "modal": "interactive_dismiss_disabled", "content": "long_scroll"}
  ],
  "additional_reference": {"ipad": "required when supported runtime is available", "resizable_environment": "required when available", "runtime_layers": ["simulator", "virtual_device", "physical_device"], "performance": ["frame_intervals", "first_input_frame_latency", "live_presenter", "snapshot_presenter"]}
}
